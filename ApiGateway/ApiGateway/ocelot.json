{
  "Routes": [
   
    {
      "UpstreamPathTemplate": "/users/sign-up",
      "DownstreamPathTemplate": "/api/User/signup",
      "DownstreamHostAndPorts": [{ "Host": "iam-service", "Port": 80 }],
      "UpstreamHttpMethod": ["POST"]
    },

    {
      "UpstreamPathTemplate": "/authentication/sign-in",
      "DownstreamPathTemplate": "/api/User/signin",
      "DownstreamHostAndPorts": [{ "Host": "iam-service", "Port": 80 }],
      "UpstreamHttpMethod": ["POST"]
    },

    {
      "UpstreamPathTemplate": "/users/{everything}",
      "DownstreamPathTemplate": "/api/User/{everything}",
      "DownstreamHostAndPorts": [{ "Host": "iam-service", "Port": 80 }],
      "UpstreamHttpMethod": ["GET", "PUT", "DELETE", "PATCH"] 
    },
    
    {
      "UpstreamPathTemplate": "/profiles/{everything}",
      "DownstreamPathTemplate": "/{everything}",
      "DownstreamHostAndPorts": [{ "Host": "profiles-service", "Port": 80 }],
      "UpstreamHttpMethod": ["GET","POST","PUT","DELETE","PATCH"]
    },
    {
      "UpstreamPathTemplate": "/payments/{everything}",
      "DownstreamPathTemplate": "/{everything}",
      "DownstreamHostAndPorts": [{ "Host": "payments-service", "Port": 80 }],
      "UpstreamHttpMethod": ["GET","POST","PUT","DELETE","PATCH"]
    },
    {
      "UpstreamPathTemplate": "/tasks/{everything}",
      "DownstreamPathTemplate": "/{everything}",
      "DownstreamHostAndPorts": [{ "Host": "tasks-service", "Port": 80 }],
      "UpstreamHttpMethod": ["GET","POST","PUT","DELETE","PATCH"]
    }
  ],
  "GlobalConfiguration": {
    "ServiceDiscoveryProvider": {
      "Host": "consul",
      "Port": 8500,
      "Type": "Consul"
    }
  }
}